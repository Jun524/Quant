# Copy to .env.live. Never commit it or send it through chat.
# Use an API key from a dedicated Binance USDT-M futures sub-account.
# Enable reading + futures trading only and require an IP whitelist.
# Withdrawals, spot/margin, internal/universal transfers, options, portfolio
# margin, and FIX permissions must all remain disabled. The live preflight
# verifies this against Binance and never writes the key or secret to reports.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# Generate distinct long random values. Do not reuse your exchange password.
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=
FREQTRADE_JWT_SECRET=
FREQTRADE_WS_TOKEN=
