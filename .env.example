# Copy this file to .env only when you are ready to connect an account.
# Dry-run and public historical-data downloads do not require API keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use a dedicated Binance Futures sub-account/key. Do not reuse the spot bot
# account: Freqtrade assumes it is the only leveraged bot on the account.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# The API server is bound to 127.0.0.1 by docker-compose.yml.
FREQTRADE_API_USERNAME=freqtrader
FREQTRADE_API_PASSWORD=replace-with-a-long-random-password
FREQTRADE_JWT_SECRET=replace-with-a-different-long-random-secret
